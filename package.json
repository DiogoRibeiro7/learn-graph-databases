{
  "name": "learn-graph-databases",
  "version": "0.1.0",
  "private": true,
  "description": "Teaching repository for graph databases, Neo4j, Cypher, graph modelling, and practical graph-based applications.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/scripts/ping.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "check": "yarn typecheck && yarn lint",
    "ping": "tsx src/scripts/ping.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:movies": "tsx src/scripts/seedMovies.ts",
    "seed:fraud": "tsx src/scripts/seedFraud.ts",
    "seed:supply": "tsx src/scripts/seedSupplyChain.ts",
    "seed:recommend": "tsx src/scripts/seedRecommendation.ts",
    "seed:rbac": "tsx src/scripts/seedRbac.ts",
    "seed:kg": "tsx src/scripts/seedKnowledgeGraph.ts",
    "query:movies": "tsx src/scripts/runMovieQueries.ts",
    "query:fraud": "tsx src/scripts/runFraudQueries.ts",
    "analyze:fraud": "tsx src/scripts/runFraudAnalysis.ts",
    "query:supply": "tsx src/scripts/runSupplyChainQueries.ts",
    "analyze:supply": "tsx src/scripts/runSupplyChainAnalysis.ts",
    "query:recommend": "tsx src/scripts/runRecommendationQueries.ts",
    "query:rbac": "tsx src/scripts/runRbacQueries.ts",
    "query:kg": "tsx src/scripts/runKnowledgeGraphQueries.ts",
    "api:start": "tsx src/api/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "neo4j-driver": "^5.28.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "4.1.3"
  }
}
